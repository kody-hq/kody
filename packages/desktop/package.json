{
  "name": "@kodycodes/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Kody desktop shell and local execution runner",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "test": "node --test test/*.test.cjs",
    "validate": "npm test",
    "test:smoke": "node test/smoke.cjs",
    "test:explorer": "node test/explorer-smoke.cjs",
    "test:browser-login": "node test/browser-login-smoke.cjs",
    "dist": "electron-builder --publish never",
    "test:packaged-cli": "node test/packaged-cli.cjs"
  },
  "dependencies": {
    "@kodycodes/cli": "file:../cli",
    "set-cookie-parser": "^3.1.2"
  },
  "devDependencies": {
    "electron": "45.2.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "codes.kody.desktop",
    "productName": "Kody",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "../../artifacts/desktop"
    },
    "files": [
      "*.cjs",
      "package.json",
      "assets/icon.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "kody"
    },
    "icon": "assets/icon.png",
    "artifactName": "Kody-${version}-${os}-${arch}.${ext}"
  },
  "author": "Kody"
}
