{
  "name": "@kodycodes/desktop",
  "version": "0.1.5",
  "private": true,
  "description": "Kody desktop shell and local execution runner",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --config electron-builder.cjs --dir --publish never",
    "test": "node --test test/*.test.cjs",
    "validate": "npm test",
    "test:smoke": "node test/smoke.cjs",
    "test:execution-ui": "node test/execution-ui-smoke.cjs",
    "test:execution-shell": "node test/execution-shell-smoke.cjs",
    "test:explorer": "node test/explorer-smoke.cjs",
    "test:browser-login": "node test/browser-login-smoke.cjs",
    "dist": "electron-builder --config electron-builder.cjs --publish never",
    "test:packaged-cli": "node test/packaged-cli.cjs",
    "dist:release": "electron-builder --config electron-builder.release.cjs --publish never"
  },
  "dependencies": {
    "@kodycodes/cli": "file:../cli",
    "electron-updater": "^6.8.11",
    "set-cookie-parser": "^3.1.2"
  },
  "devDependencies": {
    "electron": "45.2.0",
    "electron-builder": "26.18.0",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "codes.kody.desktop",
    "productName": "Kody",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "../../artifacts/desktop"
    },
    "files": [
      "*.cjs",
      "package.json",
      "assets/icon.png",
      "!electron-builder*.cjs"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "entitlements": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "When you grant host-command access, your agents can control local apps, including sending messages.",
        "NSContactsUsageDescription": "Kody uses contact names, phone numbers, and email addresses to identify people in your messages."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "kody"
    },
    "icon": "assets/icon.png",
    "artifactName": "Kody-${version}-${os}-${arch}.${ext}"
  },
  "author": "Kody"
}
