{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Syntax-highlight worker: TanStack Highlight lives only here. Origin reaches it
	// through the HIGHLIGHT service binding (no public hostname).
	"name": "kody-highlight",
	"main": "./src/index.ts",
	"compatibility_date": "2026-04-16",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"minify": true,
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
		},
	},
	"env": {
		"production": {
			"vars": {
				"SENTRY_ENVIRONMENT": "production",
			},
		},
		"preview": {
			// Previews: traces off, 10% of logs (Workers Observability cost).
			// `wrangler tail` still streams every log line live.
			"observability": {
				"enabled": true,
				"logs": {
					"enabled": true,
					"head_sampling_rate": 0.1,
					"invocation_logs": true,
				},
				"traces": {
					"enabled": false,
				},
			},
			"vars": {
				"SENTRY_ENVIRONMENT": "preview",
			},
		},
		"test": {
			"vars": {
				"SENTRY_ENVIRONMENT": "test",
			},
		},
	},
}
