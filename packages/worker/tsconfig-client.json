{
	"extends": "@epic-web/config/typescript",
	"compilerOptions": {
		"composite": true,
		"allowImportingTsExtensions": true,
		"tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.client.tsbuildinfo",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": [],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"#app/*": ["./src/app/*"],
			"#client/*": ["./client/*"],
			"#universal/*": ["./universal/*"],
			"#worker/*": ["./src/*"],
			"#mcp/*": ["./src/mcp/*"]
		}
	},
	"include": [
		"./client/**/*.ts",
		"./client/**/*.tsx",
		"./client/**/*.d.ts",
		"./universal/**/*.ts",
		"./universal/**/*.tsx"
	],
	"exclude": [
		"./client/**/*.test.ts",
		"./client/**/*.spec.ts",
		"./universal/**/*.test.ts",
		"./universal/**/*.spec.ts",
		"./universal/**/*.node.test.ts"
	]
}
