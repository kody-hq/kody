{
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"name": "worker",
	"projectType": "application",
	"sourceRoot": "packages/worker/src",
	"targets": {
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run dev"
			}
		},
		"dev-client": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run dev:client"
			}
		},
		"dev-worker": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run dev:worker"
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run build"
			}
		},
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": [
				"typecheck-src",
				"typecheck-worker-test",
				"typecheck-client-test"
			]
		},
		"typecheck-src": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -b packages/worker/tsconfig-client.json packages/worker/tsconfig-worker-typecheck.json --noEmit"
			}
		},
		"typecheck-worker-test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p packages/worker/tsconfig-worker-test.json"
			}
		},
		"typecheck-client-test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p packages/worker/tsconfig-client-test.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run --project node-unit --project workers-unit"
			}
		},
		"test-node": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node tools/run-node-tests.ts"
			}
		},
		"test-workers": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run --project workers-unit"
			}
		},
		"prepare-e2e-env": {
			"executor": "nx:run-commands",
			"inputs": [
				"{workspaceRoot}/tools/prepare-e2e-env.ts",
				"{workspaceRoot}/packages/worker/.env.example",
				"{workspaceRoot}/packages/worker/.env"
			],
			"outputs": ["{workspaceRoot}/packages/worker/.env"],
			"options": {
				"command": "node tools/prepare-e2e-env.ts"
			}
		},
		"prepare-playwright": {
			"executor": "nx:run-commands",
			"inputs": [
				"{workspaceRoot}/tools/ensure-playwright-browser.ts",
				"{workspaceRoot}/tools/install-playwright-browsers-unzip.ts",
				"{workspaceRoot}/tools/control-kody/playwright-browsers.ts"
			],
			"options": {
				"command": "npm run test:e2e:ensure"
			}
		},
		"test-mcp": {
			"executor": "nx:run-commands",
			"dependsOn": ["prepare-e2e-env"],
			"options": {
				"command": "vitest run --project mcp-e2e"
			}
		},
		"test-e2e": {
			"executor": "nx:run-commands",
			"dependsOn": ["prepare-e2e-env", "prepare-playwright"],
			"outputs": [
				"{workspaceRoot}/playwright-report",
				"{workspaceRoot}/test-results",
				"{workspaceRoot}/blob-report"
			],
			"options": {
				"command": "playwright test"
			}
		},
		"deploy": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run deploy"
			}
		},
		"migrate-local": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run migrate:local"
			}
		},
		"migrate-e2e": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run migrate:e2e"
			}
		},
		"preview": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run preview"
			}
		},
		"preview-e2e": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run preview:e2e"
			}
		},
		"generate-types": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run generate-types"
			}
		}
	},
	"tags": ["scope:worker"]
}
