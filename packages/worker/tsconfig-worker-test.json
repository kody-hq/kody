{
	"extends": "./tsconfig-worker-typecheck.json",
	"compilerOptions": {
		"composite": false,
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.worker-test.tsbuildinfo",
		"lib": ["ES2023", "ES2024.Promise", "WebWorker", "WebWorker.Iterable"],
		"types": ["@pitlane/dev/assets", "node", "@cloudflare/vitest-plugin/types"]
	},
	"include": [
		"./env.d.ts",
		"./worker-configuration.d.ts",
		"./src/**/*.d.ts",
		"./src/**/*.ts",
		"./src/**/*.tsx",
		"./universal/**/*.ts",
		"./universal/**/*.tsx",
		"../shared/src/**/*.ts",
		"../mock-servers/**/*.ts",
		"../../sentry/**/*.ts"
	],
	"exclude": []
}
