import type { Capability, DomainSpec } from './types.ts'

/** A builtin capability as recorded in the manifest: everything but the handler. */
export type CapabilityManifestCapability = Omit<Capability, 'handler'>

export type CapabilityManifestDomain = Omit<DomainSpec, 'capabilities'> & {
	capabilities: ReadonlyArray<CapabilityManifestCapability>
}

/**
 * Generated by `npm run capabilities:manifest` from the builtin domain
 * modules. See `builtin-domains.ts`.
 */
export declare const capabilityManifest: {
	domains: ReadonlyArray<CapabilityManifestDomain>
}
