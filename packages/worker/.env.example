# Saved-secret encryption key (required).
# Set a dedicated value in production to decouple secret-store encryption from
# cookie signing. See docs/contributing/secret-rotation.md.

# Optional (preview uses request origin by default; password-reset email sends
# from kody@<APP_BASE_URL hostname> when set)
APP_BASE_URL=

# Optional override for the user email domain. Defaults to
# inbox.<APP_BASE_URL hostname> (e.g. inbox.kody.codes): every user inbox
# and user outbound sender lives at {username}@<this domain>, keeping user
# mail separate from system transactional mail on the apex.
# USER_EMAIL_DOMAIN=

# Optional override for the system email domain (kody@<domain> transactional
# sender and operator inboxes). Defaults to the APP_BASE_URL hostname.
# SYSTEM_EMAIL_DOMAIN=

# Optional comma-separated previous email domains still accepted for inbound
# mail during a domain migration (delivery resolves to the same inboxes;
# outbound always sends from the canonical domains).
# LEGACY_USER_EMAIL_DOMAINS=
# LEGACY_SYSTEM_EMAIL_DOMAINS=

# Social login ("Sign in with GitHub / Google / X / Discord"). Optional: a
# provider's buttons only appear when both its client id and secret are set.
# The default MOCK_ client ids enable an in-worker mock flow (no provider app
# or network needed) on non-production runtimes only; replace them with real
# provider app credentials to test against the live providers locally.
# See docs/contributing/social-login.md for provider app setup.
GITHUB_CLIENT_ID=MOCK_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=MOCK_GITHUB_CLIENT_SECRET
GOOGLE_CLIENT_ID=MOCK_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=MOCK_GOOGLE_CLIENT_SECRET
X_CLIENT_ID=MOCK_X_CLIENT_ID
X_CLIENT_SECRET=MOCK_X_CLIENT_SECRET
DISCORD_CLIENT_ID=MOCK_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=MOCK_DISCORD_CLIENT_SECRET

# Official Kody Discord guild-role sync (optional). Bot token + guild id plus
# at least one role id must be set before connect/login/subscribe/disconnect
# will assign or remove guild roles. Standard/Pro follow orgs.stripe_plan,
# not the manual grant.
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_MEMBER_ROLE_ID=
# DISCORD_STANDARD_ROLE_ID=
# DISCORD_PRO_ROLE_ID=

# Workers AI embedding gateway (optional; production/preview sync this as a Worker secret)
# AI_GATEWAY_ID=your-cloudflare-ai-gateway-id
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Fathom Analytics (optional; production sets this as a Wrangler var in
# wrangler.jsonc). When set, SSR pages embed the Fathom tracker script.
# FATHOM_SITE_ID=WKKSDJGN

# YouTube watch overlay (optional; production/preview set the playlist as a
# Wrangler var). Comma-separated playlist ids and extra video ids. `none`
# disables playlists. Unset skips playlist fetch.
# YOUTUBE_ALLOWED_PLAYLIST_IDS=PLV5CVI1eNcJhP4nrJt85L7PxHjebFpDfY
# YOUTUBE_ALLOWED_VIDEO_IDS=

# Optional origin-only YouTube Data API key for homepage hero playlist order.
# Unset is fine: the Worker reads the unlisted chooser playlist through YouTube's
# public browse endpoint.
# YOUTUBE_DATA_API_KEY=

# Build metadata (optional; deploy workflows set these as Wrangler vars).
# APP_COMMIT_SHA is the deployed git SHA for GET /health and Sentry release.
# APP_DEPLOY_INFO is opaque base64url JSON (commit message/date, PR and deploy
# job links). Invalid values are ignored.
# APP_COMMIT_SHA=
# APP_DEPLOY_INFO=

# Cloudflare Turnstile (optional locally). Real production refuses to boot
# without both keys (signup is open). Local `npm run dev` sets
# WRANGLER_IS_LOCAL_DEV=true, so the boot gate skips even though generated
# wrangler still copies SENTRY_ENVIRONMENT=production. Unset is fine for a
# fresh copy of this file. To exercise the widget, use Cloudflare's public
# always-pass test values (not real credentials; same ones tests use):
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Sentry (optional; omit locally if you are not sending errors to Sentry)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=development
# Optional: omit for 1.0 (default, sample all traces). Lower only if traffic grows.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry source map upload (local or CI - not Worker secrets)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# Cloudflare API / Email (optional; defaults to the public Cloudflare API, and `npm run dev` sets a mock URL + token for local email and the internal API client)
# Uses Authorization: Bearer <token> against /client/v4/* endpoints.
# Reuse `CLOUDFLARE_API_TOKEN` for the live API. In mock mode `npm run dev` injects a local token.
# CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com
# Set only when CLOUDFLARE_API_BASE_URL is a local stand-in that serves whole repo trees by commit
# (`npm run dev` sets it with the mock). The real API has no such endpoint; leave unset otherwise.
# CLOUDFLARE_API_SOURCE_SNAPSHOTS=true
# Skip starting the Cloudflare mock during dev (use live API + token in `packages/worker/.env` instead):
# SKIP_CLOUDFLARE_MOCK=1

# Cloudflare Artifacts namespace (optional; defaults to `default` for local dev and tests)
# ARTIFACTS_NAMESPACE=default

# Capability vector search (optional Worker secret).
# POST /__maintenance/reindex-capabilities with Authorization: Bearer <this value>
# repopulates built-in capability, memory, job, and saved-package vectors after
# deploys. CI can set GitHub secret CAPABILITY_REINDEX_SECRET and sync it via
# deploy workflow.
# CAPABILITY_REINDEX_SECRET=

# Jobs-only Vectorize reindex (optional Worker secret).
# POST /__maintenance/reindex-jobs with Authorization: Bearer <this value>
# rebuilds job vectors without the full capability/memory/package reindex.
# Production deploys do not require this — capability reindex already refreshes
# job vectors.
# JOB_REINDEX_SECRET=

# Dedicated canary OAuth access token for the hourly authenticated MCP
# execute fallback (POST /__maintenance/mcp-execute-health). Organic
# successful execute completions skip that synthetic. Leave unset locally.
# MCP_EXECUTE_HEALTH_CANARY_ACCESS_TOKEN=

# Kit (kit.com) exist-only tagging (optional Worker secret + tag id).
# Account signup best-effort tags existing Kit subscribers with signed_up::kody
# (never creates Kit subscribers; never fails signup).
# Non-production skips Kit when KIT_API_KEY is unset.
# KIT_API_KEY=
# Optional override (default matches the production Kit tag).
# KIT_SIGNED_UP_TAG_ID=21252175

# Stripe subscription billing (optional). When STRIPE_SECRET_KEY is unset,
# billing is disabled: the account billing page shows plan info plus a
# "Billing is not configured" notice, and success/portal/cron skip safely.
# Checkout sessions are created server-side for authenticated users.
# STRIPE_SECRET_KEY=sk_test_...
# Platform webhook signing secret for POST /webhooks/stripe (whsec_...).
# When unset, the webhook endpoint returns 503.
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_API_BASE_URL=https://api.stripe.com
# Purchasable Pro checkout ($12/month, $120/year) with prepaid credits.
# Never reuse a retired Standard or Pro price id here.
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_PRO_YEARLY_PRICE_ID=price_...
# Billing Portal configuration for Manage subscription and switching to Pro
# (bpc_...). Unset uses the Stripe account default configuration.
# STRIPE_BILLING_PORTAL_CONFIGURATION_ID=bpc_...

