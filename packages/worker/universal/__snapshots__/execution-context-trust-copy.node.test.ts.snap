exports[`opt-in copy for every access combination > allowlist 1`] = `
{
  "chainFullNote": "Your chain is full, so this context will not be added to it.",
  "checkboxLabel": "Add it to the end of my fallback chain",
  "lan": null,
  "managersNote": "Context managers see run metadata in the context's run history (who, when, duration, outcome), never results.",
  "paragraphs": [
    "Your runs will execute on buildbox, a machine operated by @sam. @sam can see the code, inputs, logs and results of your runs. Runs that can use your credentials cannot run here; they go to the next usable entry in your chain, or fail if there is none.",
    "Your runs get this machine's network position and access: files: 1 path, read · local network: no · internet: allowlist of 4 hosts · Kody APIs: none.",
    "While your run is active, @sam's machine can make Kody API calls as you, within that Kody API access, and can change the results your run returns.",
  ],
  "title": "Opt into buildbox?",
}
`;

