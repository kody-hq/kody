exports[`register copy, personal and team, has no --no-chain and names kody login > personal 1`] = `
{
  "after": "It appears here within a few seconds, marked Not in any chain. Add it to your chain to start using it, or share it.",
  "body": "Registration happens from the CLI because the context key is generated on the machine and never leaves it. On the machine that should run code:",
  "commands": [
    "npm install -g @kodycodes/cli",
    "kody login",
    "kody context register --name my-machine",
    "kody daemon",
  ],
  "login": "If your Kody login predates execution context permissions, registering fails and tells you to run \`kody login\` again first. Other logins keep working as they are.",
  "trust": [
    "Code sent to this context runs on that machine, under the account that runs kody daemon.",
    "It starts as Only me. If you share it, the people you share it with run code on that machine, and you can see their code, inputs, logs, results and the responses of credentialed requests their runs make. Their credential values stay on Kody.",
    "What it exposes (files, local network, internet) is set on the machine; the CLI prints it.",
  ],
}
`;

exports[`register copy, personal and team, has no --no-chain and names kody login > team 1`] = `
{
  "after": "It appears here within a few seconds, marked Not in any chain. Add it to your chain to start using it, or share it.",
  "body": "Registration happens from the CLI because the context key is generated on the machine and never leaves it. On the machine that should run code:",
