exports[`register copy, personal and team, names kody login > personal 1`] = `
{
  "after": "kody connect registers the machine and offers to install kody daemon as a background service (Linux and macOS), so it keeps running after reboots and crashes. Check it with kody daemon status. If you skip that, run kody daemon in a terminal or kody daemon install later. It appears here within a few seconds, marked Not in any chain. Add it to your chain to start using it, or share it.",
  "body": "Registration happens from the CLI because the context key is generated on the machine and never leaves it. On the machine that should run code:",
  "commands": [
    "npm install -g @kodycodes/cli",
    "kody login",
    "kody connect --name my-machine",
  ],
  "login": "If your Kody login predates execution context permissions, registering fails and tells you to run \`kody login\` again first. Other logins keep working as they are.",
  "trust": [
    "Code sent to this context runs on that machine, under the account that runs kody daemon.",
    "It starts as Only me. Your runs on it use your credentials as in Kody cloud: those requests leave from Kody cloud, so the values never reach that machine. Its Kody API allowlist can narrow what runs there may call. If you share it, the people you share it with run code on that machine and you can see their code, inputs, logs and results. Their runs cannot use their credentials or start workflows there, and Kody APIs kept for Kody cloud refuse them.",
    "What it exposes (files, local network, internet) is set on the machine; the CLI prints it.",
  ],
}
`;

exports[`register copy, personal and team, names kody login > team 1`] = `
{
  "after": "kody connect registers the machine and offers to install kody daemon as a background service (Linux and macOS), so it keeps running after reboots and crashes. Check it with kody daemon status. If you skip that, run kody daemon in a terminal or kody daemon install later. It appears here within a few seconds, marked Not in any chain. Add it to your chain to start using it, or share it.",
  "body": "Registration happens from the CLI because the context key is generated on the machine and never leaves it. On the machine that should run code:",
  "commands": [
    "npm install -g @kodycodes/cli",
    "kody login",
    "kody connect --name my-machine --org acme",
  ],
  "login": "If your Kody login predates execution context permissions, registering fails and tells you to run \`kody login\` again first. Other logins keep working as they are.",
  "trust": [
    "Code sent to this context runs on that machine, under the account that runs kody daemon.",
    "It starts as Only me. Your runs on it use your credentials as in Kody cloud: those requests leave from Kody cloud, so the values never reach that machine. Its Kody API allowlist can narrow what runs there may call. If you share it, the people you share it with run code on that machine and you can see their code, inputs, logs and results. Their runs cannot use their credentials or start workflows there, and Kody APIs kept for Kody cloud refuse them.",
    "What it exposes (files, local network, internet) is set on the machine; the CLI prints it.",
  ],
}
`;

exports[`share copy for every access combination, as operator and as manager > allowlist:manager 1`] = `
{
  "firstShareRuntimeNote": "Others' runs can call no Kody APIs until you allow some.",
  "lan": null,
  "noInviteLinksNote": "Add people by their Kody username. There are no invite links, so access cannot be forwarded.",
  "ownerWithoutManageNote": "Only @sam or people with Manage can add access.",
  "paragraphs": [
    "Anyone you share with can run code on this machine (operated by @sam) after they opt in. @sam will be able to see their code, inputs, logs and results. Their runs that can use credentials cannot run here; they go to the next usable entry in their chain, or fail if there is none.",
    "Their runs get: files: 1 path, read · local network: no · internet: allowlist of 4 hosts · Kody APIs: none.",
    "While their run is active, this machine can make Kody API calls as them (within that Kody API access) and can change their results.",
  ],
  "title": "Share buildbox",
}
`;

