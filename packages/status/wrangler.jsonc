{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "kody-status",
	"main": "./worker.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
		},
	},
	// One probe pass per minute; incidents open after three consecutive failures.
	"triggers": {
		"crons": ["* * * * *"],
	},
	// Deliberately independent from the main worker: the status page must stay
	// up when main-app deploys break or the app D1 database is down, so it
	// has its own domain and its own Durable Object storage.
	"routes": [
		{
			"pattern": "status.kody.codes",
			"custom_domain": true,
		},
	],
	"services": [
		{
			// Worker-to-worker only. Not a public jobs hostname.
			"binding": "JOBS",
			"service": "kody-jobs",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "STATUS_STORE",
				"class_name": "StatusStore",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["StatusStore"],
		},
	],
	// Named favicon PNGs. `/` has no index.html, so the worker still
	// renders the page. `/favicon.ico` is worker-handled and 302s to the
	// current overall-status file.
	"assets": {
		"directory": "./public",
		"html_handling": "none",
		"not_found_handling": "none",
	},
	"vars": {
		"PRIMARY_ORIGIN": "https://kody.codes",
		"PACKAGE_APP_ORIGIN": "https://kody.run",
		"STATUS_PAGE_URL": "https://status.kody.codes",
		"ALERT_EMAIL_TO": "me@kentcdodds.com",
		"ALERT_EMAIL_FROM": "kody@kody.codes",
		"STATUS_ALERT_DAILY_LIMIT": "6",
		// Production Kody Cloudflare account (same as the main worker); the
		// matching CLOUDFLARE_API_TOKEN (Email Sending only) is a Worker secret
		// the deploy workflow syncs from CLOUDFLARE_STATUS_API_TOKEN.
		"CLOUDFLARE_ACCOUNT_ID": "a99ee2e72728dd52902ef288b7b1447d",
		"BUILD_COMMIT": "REPLACE_AT_DEPLOY_TIME",
	},
}
