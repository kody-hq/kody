{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Package runtime Worker (ADR 0016): the untrusted-code execution lane
	// extracted from the main `kody` Worker. Owns the package-app origin
	// (PACKAGE_APP_BASE_URL), inline package-app serving, the package
	// invocation API, dynamic callable workflows, and the runtime Durable
	// Objects (StorageRunner, RunLog, PackageRealtimeSession). The entry module lives in
	// packages/worker/src/runtime-worker.ts so the shared source tree,
	// `#worker`/`#app` import maps, and the pre-bundled generated
	// modules resolve identically to the main Worker.
	"name": "kody-runtime",
	// Birthday Week 2026-10-01: pending I/O keeps a DO from idle eviction for
	// up to 15 minutes per operation (execute / StorageRunner / RunLog /
	// PackageRealtimeSession). Date default on 2026-10-01; bump here for the
	// execute-path DO host. Keep the flag explicit — see platform-worker.
	// https://developers.cloudflare.com/workers/configuration/compatibility-flags/#durable-object-io-tasks-prevent-eviction
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public",
		"durable_object_io_tasks_prevent_eviction",
	],
	// Same rationale as the main worker: package runtime lanes fan out into
	// many D1 + Durable Object subrequests per invocation.
	"limits": {
		"subrequests": 100000,
	},
	"main": "../worker/src/runtime-worker.ts",
	"minify": true,
	"upload_source_maps": true,
	// Mirrors packages/worker/wrangler.jsonc: the module-graph builders
	// dynamically import the pre-bundled worker-bundler modules from
	// `packages/worker/src/node_modules/.kody-generated/` (base_dir
	// defaults to the entry module's directory, which is
	// packages/worker/src). That `node_modules/` prefix keeps wrangler's
	// additional-module watcher off `esbuild.wasm` (Friction #1789).
	"find_additional_modules": true,
	"rules": [
		{
			"type": "Text",
			"globs": ["./**/*.md", "../**/*.md"],
			"fallthrough": true,
		},
		{
			// Allowlisted generated filenames only. A `*.mjs` glob uploads
			// stray files under `node_modules/.kody-generated/` (Friction #2504).
			// Keep this list equal to `tools/worker-additional-module-allowlist.ts`.
			"type": "ESModule",
			"globs": [
				"generated/guide-catalog.mjs",
				"generated/guide-metadata.mjs",
				"./generated/guide-catalog.mjs",
				"./generated/guide-metadata.mjs",
				"node_modules/.kody-generated/worker-bundler.mjs",
				"node_modules/.kody-generated/worker-bundler-typescript.mjs",
				"node_modules/.kody-generated/oauth-provider.mjs",
				"node_modules/.kody-generated/local-execute-runtime-support.mjs",
				"node_modules/.kody-generated/isomorphic-git.mjs",
				"node_modules/.kody-generated/postal-mime.mjs",
				"node_modules/.kody-generated/codemode-normalize.mjs",
				"./node_modules/.kody-generated/worker-bundler.mjs",
				"./node_modules/.kody-generated/worker-bundler-typescript.mjs",
				"./node_modules/.kody-generated/oauth-provider.mjs",
				"./node_modules/.kody-generated/local-execute-runtime-support.mjs",
				"./node_modules/.kody-generated/isomorphic-git.mjs",
				"./node_modules/.kody-generated/postal-mime.mjs",
				"./node_modules/.kody-generated/codemode-normalize.mjs",
			],
			"fallthrough": true,
		},
		{
			"type": "CompiledWasm",
			"globs": ["node_modules/.kody-generated/esbuild.wasm"],
			"fallthrough": true,
		},
	],
	// Production Durable Object storage moves with the classes from the main
	// `kody` script via a transfer migration; this applies on the first
	// production deploy of this Worker. See
	// docs/contributing/architecture/runtime-worker-migration-runbook.md for
	// the coordinated deploy order. The preview environment overrides this
	// with `new_sqlite_classes` because preview worker pairs are created
	// fresh per PR with no storage to preserve.
	"migrations": [
		{
			"tag": "v1",
			"transferred_classes": [
				{
					"from": "StorageRunner",
					"from_script": "kody",
					"to": "StorageRunner",
				},
				{
					"from": "RunLog",
					"from_script": "kody",
					"to": "RunLog",
				},
				{
					"from": "PackageRealtimeSession",
					"from_script": "kody",
					"to": "PackageRealtimeSession",
				},
				{
					"from": "PackageServiceInstance",
					"from_script": "kody",
					"to": "PackageServiceInstance",
				},
			],
			// Wrangler 4.131+ builds getDurableObjectClassNameToUseSQLiteMap on
			// real `wrangler deploy` (container prep) and ignores
			// transferred_classes. v2 deletes PackageServiceInstance; without a
			// local-map create, deploy fails even when tag v2 is already
			// applied remotely. Cloudflare will not re-run v1 (remote tag is
			// already v2).
			"new_sqlite_classes": ["PackageServiceInstance"],
		},
		{
			"tag": "v2",
			"deleted_classes": ["PackageServiceInstance"],
		},
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1,
		},
	},
	"env": {
		"production": {
			"observability": {
				"enabled": true,
				"logs": {
					"enabled": true,
					"head_sampling_rate": 1,
					"invocation_logs": true,
				},
				"traces": {
					"enabled": true,
					"head_sampling_rate": 0.1,
					"destinations": ["sentry-otlp-traces"],
				},
			},
			"worker_loaders": [
				{
					"binding": "LOADER",
				},
				{
					"binding": "APP_LOADER",
				},
			],
			"workflows": [
				{
					"binding": "DYNAMIC_CALLABLE_WORKFLOWS",
					"name": "kody-runtime-dynamic-callable-workflows",
					"class_name": "DynamicCallableWorkflow",
				},
			],
			"durable_objects": {
				"bindings": [
					// Runtime-owned classes, local to this script.
					{
						"class_name": "StorageRunner",
						"name": "STORAGE_RUNNER",
					},
					{
						"class_name": "RunLog",
						"name": "RUN_LOG",
					},
					{
						"class_name": "PackageRealtimeSession",
						"name": "PACKAGE_REALTIME_SESSION",
					},
					// Platform-worker classes reached cross-script (ADR 0034).
					{
						"class_name": "UserMeter",
						"name": "USER_METER",
						"script_name": "kody-platform",
					},
					{
						"class_name": "MCP",
						"name": "MCP_OBJECT",
						"script_name": "kody-platform",
					},
					{
						"class_name": "McpClientHub",
						"name": "MCP_CLIENT_HUB",
						"script_name": "kody-platform",
					},
					{
						"class_name": "Mailbox",
						"name": "MAILBOX",
						"script_name": "kody-platform",
					},
					{
						"class_name": "RepoSession",
						"name": "REPO_SESSION",
						"script_name": "kody-platform",
					},
					// Catalog authority for repo_* capabilities. Package and
					// workflow execution on this worker open/list/publish
					// sessions through the platform Worker's per-user index.
					{
						"class_name": "RepoSessionIndex",
						"name": "REPO_SESSION_INDEX",
						"script_name": "kody-platform",
					},
				],
			},
			// Jobs worker service binding (ADR 0016): package save/delete paths
			// sync the JobManager alarm through this coarse-grained contract.
			"services": [
				{
					"binding": "JOBS",
					"service": "kody-jobs",
					"entrypoint": "JobsService",
				},
			],
			"d1_databases": [
				{
					"binding": "APP_DB",
					"database_name": "kody",
					"migrations_dir": "./../worker/migrations",
				},
				{
					"binding": "AUDIT_DB",
					"database_name": "kody-audit",
					"migrations_dir": "./../worker/audit-migrations",
				},
			],
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
				},
				{
					"binding": "BUNDLE_ARTIFACTS_KV",
				},
			],
			"r2_buckets": [
				{
					"binding": "COMMUNITY_ASSETS",
					"bucket_name": "kody-community-assets",
				},
				// Capability execution on the runtime lane reads email
				// attachments (email-attachment-get) from the shared blob store.
				{
					"binding": "EMAIL_BLOBS",
					"bucket_name": "kody-email-blobs",
				},
			],
			"queues": {
				"producers": [
					{
						"binding": "PLATFORM_FEEDBACK_DISPATCH_QUEUE",
						"queue": "kody-platform-feedback-dispatch",
					},
					{
						"binding": "COMMUNITY_ACTIVITY_DISPATCH_QUEUE",
						"queue": "kody-community-activity-dispatch",
					},
					{
						"binding": "COMMUNITY_LISTING_PUBLISHED_DISPATCH_QUEUE",
						"queue": "kody-community-listing-published-dispatch",
					},
					{
						"binding": "PACKAGE_EVENTS_DISPATCH_QUEUE",
						"queue": "kody-package-events-dispatch",
					},
					{
						"binding": "WEBHOOK_DISPATCH_QUEUE",
						"queue": "kody-webhook-dispatch",
					},
				],
			},
			"vectorize": [
				{
					"binding": "CAPABILITY_VECTOR_INDEX",
					"index_name": "kody-capabilities-prod",
				},
			],
			"analytics_engine_datasets": [
				{
					"binding": "USAGE_EVENTS",
					"dataset": "kody_usage_events",
				},
				{
					"binding": "FLAG_EXPOSURES",
					"dataset": "kody_flag_exposures",
				},
				{
					"binding": "MCP_PROTOCOL_EVENTS",
					"dataset": "kody_mcp_protocol_events",
				},
				{
					"binding": "ONBOARDING_FUNNEL_EVENTS",
					"dataset": "kody_onboarding_funnel_events",
				},
			],
			"ai": {
				"binding": "AI",
			},
			"vars": {
				"SENTRY_ENVIRONMENT": "production",
				"SENTRY_TRACES_SAMPLE_RATE": 0,
				"ARTIFACTS_NAMESPACE": "production",
				"PACKAGE_APP_BASE_URL": "https://kody.run",
			},
		},
		"preview": {
			// Previews: traces off, 10% of logs (Workers Observability cost).
			// `wrangler tail` still streams every log line live.
			"observability": {
				"enabled": true,
				"logs": {
					"enabled": true,
					"head_sampling_rate": 0.1,
					"invocation_logs": true,
				},
				"traces": {
					"enabled": false,
				},
			},
			// Preview worker pairs are created fresh per PR: the runtime-owned
			// classes are new namespaces here, not a transfer.
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"StorageRunner",
						"RunLog",
						"PackageRealtimeSession",
						"PackageServiceInstance",
					],
				},
				{
					"tag": "v2",
					"deleted_classes": ["PackageServiceInstance"],
				},
			],
			"worker_loaders": [
				{
					"binding": "LOADER",
				},
				{
					"binding": "APP_LOADER",
				},
			],
			"workflows": [
				{
					"binding": "DYNAMIC_CALLABLE_WORKFLOWS",
					"name": "kody-runtime-preview-dynamic-callable-workflows",
					"class_name": "DynamicCallableWorkflow",
				},
			],
			"durable_objects": {
				"bindings": [
					{
						"class_name": "StorageRunner",
						"name": "STORAGE_RUNNER",
					},
					{
						"class_name": "RunLog",
						"name": "RUN_LOG",
					},
					{
						"class_name": "PackageRealtimeSession",
						"name": "PACKAGE_REALTIME_SESSION",
					},
					{
						"class_name": "UserMeter",
						"name": "USER_METER",
						"script_name": "kody-platform",
					},
					{
						"class_name": "MCP",
						"name": "MCP_OBJECT",
						"script_name": "kody-platform",
					},
					{
						"class_name": "McpClientHub",
						"name": "MCP_CLIENT_HUB",
						"script_name": "kody-platform",
					},
					{
						"class_name": "Mailbox",
						"name": "MAILBOX",
						"script_name": "kody-platform",
					},
					{
						"class_name": "RepoSession",
						"name": "REPO_SESSION",
						"script_name": "kody-platform",
					},
					// Catalog authority for repo_* capabilities. Package and
					// workflow execution on this worker open/list/publish
					// sessions through the platform Worker's per-user index.
					{
						"class_name": "RepoSessionIndex",
						"name": "REPO_SESSION_INDEX",
						"script_name": "kody-platform",
					},
				],
			},
			// Jobs worker service binding (ADR 0016): the preview config
			// generator rewrites the service to the per-preview jobs worker
			// name, same as the main worker's JOBS binding.
			"services": [
				{
					"binding": "JOBS",
					"service": "kody-jobs",
					"entrypoint": "JobsService",
				},
			],
			"d1_databases": [
				{
					"binding": "APP_DB",
					"database_name": "kody-preview",
					"migrations_dir": "./../worker/migrations",
				},
				{
					"binding": "AUDIT_DB",
					"database_name": "kody-preview-audit",
					"migrations_dir": "./../worker/audit-migrations",
				},
			],
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
				},
				{
					"binding": "BUNDLE_ARTIFACTS_KV",
				},
			],
			"r2_buckets": [
				{
					"binding": "COMMUNITY_ASSETS",
					"bucket_name": "kody-preview-community-assets",
				},
				{
					"binding": "EMAIL_BLOBS",
					"bucket_name": "kody-preview-email-blobs",
				},
			],
			// Kept in lockstep with origin env.preview producers.
			// See tools/ci/preview-queue-plan.ts.
			"queues": {
				"producers": [
					{
						"binding": "PLATFORM_FEEDBACK_DISPATCH_QUEUE",
						"queue": "kody-preview-platform-feedback-dispatch",
					},
					{
						"binding": "COMMUNITY_ACTIVITY_DISPATCH_QUEUE",
						"queue": "kody-preview-community-activity-dispatch",
					},
					{
						"binding": "COMMUNITY_LISTING_PUBLISHED_DISPATCH_QUEUE",
						"queue": "kody-preview-community-listing-published-dispatch",
					},
					{
						"binding": "WEBHOOK_DISPATCH_QUEUE",
						"queue": "kody-preview-webhook-dispatch",
					},
				],
			},
			"vectorize": [
				{
					"binding": "CAPABILITY_VECTOR_INDEX",
					"index_name": "kody-capabilities-preview",
				},
			],
			"analytics_engine_datasets": [
				{
					"binding": "USAGE_EVENTS",
					"dataset": "kody_usage_events_preview",
				},
				{
					"binding": "FLAG_EXPOSURES",
					"dataset": "kody_flag_exposures_preview",
				},
				{
					"binding": "MCP_PROTOCOL_EVENTS",
					"dataset": "kody_mcp_protocol_events_preview",
				},
				{
					"binding": "ONBOARDING_FUNNEL_EVENTS",
					"dataset": "kody_onboarding_funnel_events_preview",
				},
			],
			"ai": {
				"binding": "AI",
			},
			"vars": {
				"SENTRY_ENVIRONMENT": "preview",
				"ARTIFACTS_NAMESPACE": "preview",
			},
		},
	},
}
