{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "main",
	"workspaceLayout": {
		"libsDir": "packages"
	},
	"namedInputs": {
		"sharedGlobals": [
			"{workspaceRoot}/package.json",
			"{workspaceRoot}/package-lock.json",
			"{workspaceRoot}/tsconfig*.json"
		],
		"default": ["{projectRoot}/**/*", "sharedGlobals"],
		"workspace": [
			"{workspaceRoot}/**/*",
			"{workspaceRoot}/.agents/**/*",
			"{workspaceRoot}/.cursor/**/*",
			"{workspaceRoot}/.github/**/*",
			"{workspaceRoot}/.husky/**/*"
		],
		"suiteSupport": [
			"{workspaceRoot}/vitest*.ts",
			"{workspaceRoot}/vite.config.ts",
			"{workspaceRoot}/wrangler-env.ts",
			"{workspaceRoot}/tools/**/*",
			"{workspaceRoot}/docs/**/*",
			"{workspaceRoot}/packages/mock-servers/**/*",
			"{workspaceRoot}/packages/jobs-worker/**/*",
			"{workspaceRoot}/packages/highlight-worker/**/*",
			"{workspaceRoot}/packages/push-queue-worker/**/*",
			"{workspaceRoot}/packages/shared/**/*",
			"{workspaceRoot}/skills-lock.json",
			"{workspaceRoot}/.agents/**/*"
		]
	},
	"targetDefaults": {
		"build": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"{workspaceRoot}/docs/guides/**/*",
				"{workspaceRoot}/tools/**/*",
				"{workspaceRoot}/vite.config.ts",
				"{workspaceRoot}/wrangler-env.ts"
			]
		},
		"typecheck": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"{workspaceRoot}/packages/worker/**/*",
				"{workspaceRoot}/packages/shared/**/*",
				"{workspaceRoot}/packages/mock-servers/**/*"
			]
		},
		"test": {
			"cache": true,
			"inputs": ["workspace", { "env": "CI" }]
		},
		"test-node": {
			"cache": true,
			"inputs": [
				"workspace",
				{
					"env": "CI"
				},
				{
					"env": "NODE_TEST_SHARD"
				},
				{ "env": "KODY_TEST_MODULE_MAP_OUT" }
			],
			"outputs": ["{workspaceRoot}/.tmp/test-module-map/node-unit.json"]
		},
		"test-workers": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"suiteSupport",
				{ "env": "CI" },
				{ "env": "WORKERS_TEST_SHARD" },
				{ "env": "KODY_TEST_MODULE_MAP_OUT" }
			],
			"outputs": ["{workspaceRoot}/.tmp/test-module-map/workers-unit.json"]
		},
		"test-mcp": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"suiteSupport",
				{
					"env": "CI"
				},
				{
					"env": "GITHUB_ACTIONS"
				}
			]
		},
		"prepare-e2e-env": {
			"cache": true
		},
		"prepare-playwright": {
			"cache": false
		},
		"test-e2e": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"suiteSupport",
				"{workspaceRoot}/e2e/**/*",
				"{workspaceRoot}/playwright.config.ts",
				{
					"env": "CI"
				},
				{
					"env": "E2E_SHARD"
				}
			]
		},
		"dev": {
			"cache": false
		},
		"dev-client": {
			"cache": false
		},
		"dev-worker": {
			"cache": false
		},
		"preview": {
			"cache": false
		},
		"preview-e2e": {
			"cache": false
		},
		"typecheck-src": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"{workspaceRoot}/packages/worker/**/*",
				"{workspaceRoot}/packages/shared/**/*",
				"{workspaceRoot}/packages/mock-servers/**/*"
			]
		},
		"typecheck-worker-test": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"{workspaceRoot}/packages/worker/**/*",
				"{workspaceRoot}/packages/shared/**/*",
				"{workspaceRoot}/packages/mock-servers/**/*"
			]
		},
		"typecheck-client-test": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"{workspaceRoot}/packages/worker/**/*",
				"{workspaceRoot}/packages/shared/**/*",
				"{workspaceRoot}/packages/mock-servers/**/*"
			]
		},
		"typecheck-start-server": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"{workspaceRoot}/packages/worker/**/*",
				"{workspaceRoot}/packages/shared/**/*",
				"{workspaceRoot}/packages/mock-servers/**/*",
				"{workspaceRoot}/tools/run-tsc.ts",
				"{workspaceRoot}/tools/node-runtime.ts",
				"!{workspaceRoot}/packages/worker/.generated/start-types/**/*"
			]
		},
		"typecheck-start": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"{workspaceRoot}/packages/worker/**/*",
				"{workspaceRoot}/packages/shared/**/*",
				"{workspaceRoot}/packages/mock-servers/**/*",
				"{workspaceRoot}/tools/run-tsc.ts",
				"{workspaceRoot}/tools/node-runtime.ts",
				"!{workspaceRoot}/packages/worker/.generated/start-types/**/*"
			]
		},
		"typecheck-start-tests": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"{workspaceRoot}/packages/worker/**/*",
				"{workspaceRoot}/packages/shared/**/*",
				"{workspaceRoot}/packages/mock-servers/**/*",
				"{workspaceRoot}/tools/run-tsc.ts",
				"{workspaceRoot}/tools/node-runtime.ts",
				"!{workspaceRoot}/packages/worker/.generated/start-types/**/*"
			]
		},
		"typecheck-start-server-tests": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"{workspaceRoot}/packages/worker/**/*",
				"{workspaceRoot}/packages/shared/**/*",
				"{workspaceRoot}/packages/mock-servers/**/*",
				"{workspaceRoot}/tools/run-tsc.ts",
				"{workspaceRoot}/tools/node-runtime.ts",
				"!{workspaceRoot}/packages/worker/.generated/start-types/**/*"
			]
		}
	},
	"tui": {
		"enabled": false
	},
	"neverConnectToCloud": true,
	"analytics": false
}
