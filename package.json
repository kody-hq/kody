{
  "name": "kody",
  "private": true,
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "imports": {
    "#app/*": "./packages/worker/src/app/*",
    "#client/*": "./packages/worker/client/*",
    "#universal/*": "./packages/worker/universal/*",
    "#worker/*": "./packages/worker/src/*",
    "#*": "./*",
    "#mcp/*": "./packages/worker/src/mcp/*"
  },
  "description": "Your agents' cloud: the memory, keys, code, and automations your AI agent keeps, portable across every MCP host",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,css,yml,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "scripts": {
    "dev": "node --env-file=packages/worker/.env cli.ts",
    "dev:ensure": "node --env-file-if-exists=packages/worker/.env tools/ensure-dev.ts",
    "dev:client": "vite",
    "dev:vite": "vite",
    "clean:client": "node -e \"const{rmSync}=require('node:fs');for(const p of ['packages/worker/public/assets','packages/worker/public/client-manifest.json','dist'])rmSync(p,{recursive:true,force:true})\"",
    "dev:worker": "vite",
    "dev:mock-cloudflare": "node --env-file=packages/worker/.env ./wrangler-env.ts dev --local --config packages/mock-servers/cloudflare/wrangler.jsonc",
    "deploy": "node --input-type=module -e \"if (['preview','test'].includes(process.env.CLOUDFLARE_ENV ?? '')) { await import('./tools/prepare-e2e-env.ts'); }\" && node --env-file=packages/worker/.env tools/deploy.ts --outdir .wrangler/sentry-bundle --upload-source-maps",
    "sentry:upload-sourcemaps": "node tools/sentry-upload-sourcemaps.ts",
    "build": "vite build && node tools/framework-comparison/verify-redact-build.mjs",
    "backup:build": "wrangler deploy --dry-run --config packages/backup-control-plane/wrangler.jsonc",
    "backup:deploy": "wrangler deploy --config packages/backup-control-plane/wrangler.jsonc",
    "status:build": "wrangler deploy --dry-run --config packages/status/wrangler.jsonc",
    "status:deploy": "wrangler deploy --config packages/status/wrangler.jsonc",
    "nx-cache:build": "wrangler deploy --dry-run --config packages/nx-cache/wrangler.jsonc",
    "nx-cache:deploy": "wrangler deploy --config packages/nx-cache/wrangler.jsonc",
    "nx-cache:smoke": "node tools/nx-remote-cache-smoke.ts",
    "runtime:build": "node ./wrangler-env.ts deploy --dry-run --outdir .wrangler/runtime-dry-run --config packages/runtime-worker/wrangler.jsonc",
    "platform:build": "node ./wrangler-env.ts deploy --dry-run --outdir .wrangler/platform-dry-run --config packages/platform-worker/wrangler.jsonc",
    "jobs:build": "wrangler deploy --dry-run --outdir .tmp/jobs-worker-build --config packages/jobs-worker/wrangler.jsonc --env production",
    "jobs:deploy": "wrangler deploy --config packages/jobs-worker/wrangler.jsonc --env production",
    "highlight:build": "wrangler deploy --dry-run --outdir .tmp/highlight-worker-build --config packages/highlight-worker/wrangler.jsonc --env production",
    "highlight:deploy": "wrangler deploy --config packages/highlight-worker/wrangler.jsonc --env production",
    "push-queue:build": "wrangler deploy --dry-run --outdir .tmp/push-queue-worker-build --config packages/push-queue-worker/wrangler.jsonc --env production",
    "push-queue:deploy": "wrangler deploy --config packages/push-queue-worker/wrangler.jsonc --env production",
    "api:build": "wrangler deploy --dry-run --outdir .tmp/api-worker-build --config packages/api-worker/wrangler.jsonc --env production",
    "api:deploy": "wrangler deploy --config packages/api-worker/wrangler.jsonc --env production --name kody-api",
    "api-docs:build": "wrangler deploy --dry-run --outdir .tmp/api-docs-worker-build --config packages/api-docs-worker/wrangler.jsonc",
    "api-docs:deploy": "wrangler deploy --config packages/api-docs-worker/wrangler.jsonc --name kody-api-docs",
    "backup:readiness": "node tools/disaster-recovery/canonical-readiness-cli.ts",
    "backup:resources": "node tools/ci/backup-resources-cli.ts",
    "backup:restore-drill": "node tools/disaster-recovery/d1-restore-drill-cli.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "primitives:check": "node .agents/skills/visual-recap/scripts/check-primitives-map.mjs",
    "primitives:classify": "node .agents/skills/visual-recap/scripts/classify-primitives.mjs",
    "docs:check-temporal": "node tools/check-docs-temporal-language.ts",
    "docs:check-decisions": "node tools/check-decision-record-numbers.ts",
    "docs:check-file-refs": "node tools/check-markdown-file-refs.ts",
    "docs:check-no-hosted-execute": "node tools/check-docs-no-hosted-execute.ts",
    "lockfile:check": "node tools/check-lockfile-peer-drift.ts",
    "skills-lock:check": "node tools/check-skills-lock.ts",
    "overrides:check": "node tools/check-dependency-overrides.ts",
    "mermaid:check": "node tools/check-mermaid-syntax.ts",
    "file-size-ratchet:check": "node tools/check-file-size-ratchet.ts",
    "error-agent-prompt:check": "node tools/check-error-agent-prompt.ts",
    "decorative-banners:check": "node tools/check-decorative-banners.ts",
    "slop-ratchet:check": "node tools/check-file-size-ratchet.ts && node tools/check-decorative-banners.ts",
    "knip": "knip",
    "cli:validate": "npm run validate -w @kodycodes/cli",
    "cli:openapi:check": "node --experimental-strip-types tools/generate-cli-openapi-client.ts --check",
    "deploy-guardrails:check": "node tools/check-deploy-guardrails.ts",
    "workflows:check": "node tools/check-workflow-refs.ts",
    "origin-production-exports:check": "node tools/check-origin-production-exports.ts",
    "worker-startup-bundles:check": "node tools/check-worker-startup-bundles.ts",
    "worker-startup-time:check": "node tools/check-worker-startup-time.ts",
    "migrations:check": "node tools/check-migrations.ts",
    "migrate:local": "node tools/apply-local-app-migrations.ts",
    "migrate:e2e": "node tools/apply-local-app-migrations.ts --persist-to .wrangler/state/e2e",
    "preview": "npm run migrate:local && npm run dev:vite",
    "e2e:web-server": "node tools/e2e-web-server.ts",
    "preview:e2e": "node tools/prepare-e2e-env.ts && npm run migrate:e2e && WRANGLER_PERSIST_TO=.wrangler/state/e2e npm run dev:vite",
    "preview:manual-test": "node tools/preview-manual-test.ts",
    "control-kody": "node tools/control-kody.ts",
    "latency-bench": "node tools/latency-bench/run.ts",
    "maintenance-mode": "node tools/maintenance-mode.ts",
    "site-perf": "node tools/site-perf/collect.ts",
    "generate-types": "node tools/generate-worker-configuration-types.ts",
    "generate-types:check": "node tools/check-worker-configuration-types.ts",
    "typecheck": "node tools/run-nx.ts run-many -t typecheck && npm run typecheck:start",
    "test": "node tools/run-nx.ts run worker:test",
    "test:node": "node tools/run-nx.ts run worker:test-node",
    "test:workers": "node tools/run-nx.ts run worker:test-workers",
    "test:push": "CI=1 npm run test:node && CI=1 npm run test:workers",
    "install:check": "node tools/check-installed-lockfile.ts",
    "prevalidate": "npm run install:check && node tools/build-worker-bundler-modules.ts && node tools/build-guide-catalog-modules.ts",
    "validate": "node tools/run-validate.ts",
    "validate:fix": "npm run lint:fix && npm run format",
    "test:e2e:ensure": "node tools/ensure-playwright-browser.ts",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "test:e2e:run": "node tools/run-nx.ts run worker:test-e2e",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "node tools/ensure-playwright-browser.ts",
    "test:mcp": "node tools/run-nx.ts run worker:test-mcp",
    "hooks:ensure": "node tools/ensure-cloud-agent-hooks.ts",
    "prepare": "husky && node tools/ensure-cloud-agent-hooks.ts",
    "postinstall": "patch-package",
    "nx:graph": "nx graph",
    "nx:show-projects": "nx show projects",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "soft-delete-read-filter:check": "node tools/soft-delete-read-filter.ts",
    "typecheck:start": "tsc -p packages/worker/tsconfig-start-server.json && tsc -p packages/worker/tsconfig-start.json && tsc -p packages/worker/tsconfig-start-tests.json && tsc -p packages/worker/tsconfig-start-server-tests.json",
    "build:client": "npm run build",
    "build:client:web": "npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@epic-web/config": "^3.2.1",
    "@kody-internal/shared": "file:packages/shared",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mswjs/interceptors": "^0.45.6",
    "@pitlane/dev": "^0.7.0",
    "@playwright/test": "^1.63.0",
    "@sentry/cli": "^3.8.0",
    "@types/node": "^26.6.4",
    "@types/semver": "^7.8.0",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.5",
    "esbuild": "^0.28.2",
    "get-port": "^7.2.0",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "mermaid": "^11.17.2",
    "msw": "^3.0.2",
    "nx": "^23.2.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.86.0",
    "patch-package": "8.0.1",
    "semver": "^7.8.5",
    "set-cookie-parser": "^3.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0",
    "@tanstack/intent": "0.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "brace-expansion": ">=5.0.12 <6.0.0",
    "esbuild": "$esbuild",
    "hono": ">=4.13.7 <5.0.0",
    "@hono/node-server": ">=2.0.10 <3.0.0",
    "postcss": ">=8.5.10 <9.0.0",
    "isomorphic-git": ">=1.40.0 <1.40.8",
    "ip-address": ">=10.5.1 <11.0.0",
    "fast-uri": ">=3.1.8 <4.0.0",
    "proxy-addr": ">=2.0.8 <3.0.0",
    "source-map-js": ">=1.2.2 <2.0.0",
    "smol-toml": ">=1.9.0 <2.0.0",
    "zod": "4.6.5",
    "sharp": ">=0.35.5 <1.0.0",
    "wrangler": {
      "undici": ">=7.29.1 <8.0.0"
    },
    "miniflare": {
      "undici": ">=7.29.1 <8.0.0"
    },
    "@cloudflare/vite-plugin": {
      "undici": ">=7.29.1 <8.0.0"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.11.1",
  "workspaces": [
    "packages/api-worker",
    "packages/api-docs-worker",
    "packages/backup-control-plane",
    "packages/jobs-worker",
    "packages/highlight-worker",
    "packages/push-queue-worker",
    "packages/shared",
    "packages/status",
    "packages/nx-cache",
    "packages/worker",
    "packages/cli",
    "packages/mock-servers/*"
  ],
  "allowScripts": {
    "@sentry/cli": true,
    "core-js-pure": true,
    "esbuild": true,
    "fsevents": true,
    "msw": true,
    "nx": true,
    "sharp": true,
    "unrs-resolver": true,
    "workerd": true
  },
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/react-router",
      "@tanstack/router-core",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/router-plugin",
      "@tanstack/virtual-file-routes",
      "@tanstack/redact"
    ]
  }
}
