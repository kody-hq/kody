{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": [
		"./node_modules/@epic-web/config/oxlint-config.json",
		"./tools/oxlint/oxlint-rules.json"
	],
	"plugins": ["import", "jsx-a11y", "react", "typescript", "vitest"],
	"overrides": [
		{
			"files": ["packages/cli/**"],
			"rules": {
				"vitest/no-import-node-test": "off",
				"typescript/no-explicit-any": "off",
				"eslint/no-warning-comments": "off"
			}
		},
		{
			"files": [
				"packages/worker/start/components/document-head.ts",
				"packages/worker/start/components/home-document-head.ts",
				"packages/worker/start/components/site-header.tsx",
				"packages/worker/start/page-query.ts",
				"packages/worker/universal/document-head-resolver.ts",
				"packages/worker/universal/loader-data.ts"
			],
			"rules": {
				"import/consistent-type-specifier-style": "off",
				"typescript/no-import-type-side-effects": "error"
			}
		}
	]
}
